{
  "name": "ai-track-tool",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "bin": {
    "ai-track": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "npm run build --workspace web",
    "build:all": "npm run build && npm run build:web",
    "watch:web": "npm run build --workspace web -- --watch",
    "dev": "tsx src/cli.ts",
    "dev:web": "tsx --watch src/cli.ts web",
    "test": "vitest run"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "commander": "^14.0.1",
    "diff": "^8.0.2",
    "ignore": "^7.0.5",
    "react-window": "^2.2.7"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
